# Server
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Database (local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bioverse?schema=public"

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# AI (Gemini) — optional. Without this, AI Expand / AI Tutor reply with a
# graceful "not configured" message instead of crashing.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated emails allowed to self-register as TEACHER via the public
# register form. Leave empty in local dev to allow any role (matches old
# behavior); set this in production to lock teacher signup to known emails.
TEACHER_ALLOWLIST_EMAILS=

# Cloudflare R2 (S3-compatible) storage for teacher-uploaded PDFs and
# microscope images — optional. Without these, uploads fall back to local
# disk (fine for local dev, but files are LOST on redeploy on Render's free
# tier, since its filesystem is ephemeral). Set these in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
