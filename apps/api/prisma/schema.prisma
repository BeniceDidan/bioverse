generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
}

enum MediaType {
  IMAGE
  DIAGRAM
  INFOGRAPHIC
  ANIMATION
  ILLUSTRATION
}

enum QuizType {
  PRETEST
  POSTTEST
  PRACTICE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  IMAGE_IDENTIFICATION
  DRAG_DROP
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  MATERI_BARU
  NILAI
  REMINDER
  PROGRESS
}

enum MicroscopeMode {
  BELAJAR
  IDENTIFIKASI
  LATIHAN
}

enum ChatRole {
  USER
  ASSISTANT
}

enum UploadStatus {
  UPLOADED
  READY_TO_EXPAND
  EXPANDING
  EXPANDED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  progress            Progress[]
  quizAttempts        QuizAttempt[]
  achievements        Achievement[]
  notifications       Notification[]
  bookmarks           Bookmark[]
  chatSessions        ChatSession[]
  materialUploads     MaterialUpload[]
  microscopeSlides    MicroscopeSlide[]
  quizzes             Quiz[]
  videos              Video[]

  @@map("users")
}

model StudentProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                   String?
  grade                    String?
  totalLearningTimeMinutes Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("student_profiles")
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    String?
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher_profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Learning content — Materi Jaringan Hewan
// ─────────────────────────────────────────────────────────────────────────

model Material {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections MaterialSection[]
  uploads  MaterialUpload[]

  @@map("materials")
}

model MaterialSection {
  id                    String   @id @default(cuid())
  materialId            String
  material              Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  slug                  String   @unique
  order                 Int
  title                 String
  description           String
  learningObjectives    Json // string[]
  competencies          Json // string[]
  indicators             Json // string[]
  estimatedMinutes      Int
  contentBody           String   @db.Text // markdown
  structureFunctionNote String?  @db.Text
  realLifeExamples      Json // string[]
  summary               String   @db.Text
  isPublished           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  upload           MaterialUpload?
  mediaAssets      MediaAsset[]
  videos           Video[]
  microscopeSlides MicroscopeSlide[]
  quizzes          Quiz[]
  progress         Progress[]
  bookmarks        Bookmark[]

  @@index([materialId])
  @@map("material_sections")
}

model MaterialUpload {
  id                String          @id @default(cuid())
  teacherId         String
  teacher           User            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  fileName          String
  fileUrl           String
  extractedText     String?         @db.Text
  status            UploadStatus    @default(UPLOADED)
  errorMessage      String?
  materialSectionId String?         @unique
  materialSection   MaterialSection? @relation(fields: [materialSectionId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([teacherId])
  @@map("material_uploads")
}

model MediaAsset {
  id                String          @id @default(cuid())
  materialSectionId String
  materialSection   MaterialSection @relation(fields: [materialSectionId], references: [id], onDelete: Cascade)
  type              MediaType
  title             String
  url               String
  caption           String?
  altText           String
  order             Int             @default(0)
  createdAt         DateTime        @default(now())

  @@index([materialSectionId])
  @@map("media_assets")
}

model Video {
  id                String          @id @default(cuid())
  materialSectionId String
  materialSection   MaterialSection @relation(fields: [materialSectionId], references: [id], onDelete: Cascade)
  teacherId         String?
  teacher           User?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  title             String
  description       String
  youtubeId         String
  durationSeconds   Int?
  isPublished       Boolean         @default(false)
  order             Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([materialSectionId])
  @@map("videos")
}

model MicroscopeSlide {
  id                String            @id @default(cuid())
  materialSectionId String
  materialSection   MaterialSection   @relation(fields: [materialSectionId], references: [id], onDelete: Cascade)
  teacherId         String?
  teacher           User?             @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  tissueName        String
  slideImageUrl     String
  description       String
  isPublished       Boolean           @default(false)
  order             Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  hotspots          MicroscopeHotspot[]

  @@index([materialSectionId])
  @@map("microscope_slides")
}

model MicroscopeHotspot {
  id              String          @id @default(cuid())
  slideId         String
  slide           MicroscopeSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)
  xPercent        Float
  yPercent        Float
  label           String
  tissueName      String
  tissueFunction  String
  characteristics String
  location        String
  example         String
  createdAt       DateTime        @default(now())

  @@index([slideId])
  @@map("microscope_hotspots")
}

// ─────────────────────────────────────────────────────────────────────────
// Assessment
// ─────────────────────────────────────────────────────────────────────────

model Quiz {
  id                String           @id @default(cuid())
  materialSectionId String?
  materialSection   MaterialSection? @relation(fields: [materialSectionId], references: [id], onDelete: SetNull)
  teacherId         String?
  teacher           User?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  type              QuizType
  title             String
  description       String
  timeLimitMinutes  Int?
  passingScore      Int              @default(70)
  isPublished       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  questions Question[]
  attempts  QuizAttempt[]

  @@index([materialSectionId])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType
  prompt      String       @db.Text
  imageUrl    String?
  order       Int          @default(0)
  points      Int          @default(10)
  explanation String       @db.Text

  choices Choice[]
  answers Answer[]

  @@index([quizId])
  @@map("questions")
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  matchKey   String? // pairs a PROMPT choice with its ANSWER choice for MATCHING/DRAG_DROP
  matchGroup String? // "PROMPT" | "ANSWER" — which side of a MATCHING/DRAG_DROP pair
  order      Int      @default(0)

  @@index([questionId])
  @@map("choices")
}

model QuizAttempt {
  id          String        @id @default(cuid())
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int?
  maxScore    Int?
  startedAt   DateTime      @default(now())
  submittedAt DateTime?

  answers Answer[]

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Answer {
  id                String      @id @default(cuid())
  attemptId         String
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceIds Json // string[]
  textAnswer        String?     @db.Text
  isCorrect         Boolean?
  pointsAwarded     Int         @default(0)
  createdAt         DateTime    @default(now())

  @@unique([attemptId, questionId])
  @@map("answers")
}

// ─────────────────────────────────────────────────────────────────────────
// Progress, gamification, engagement
// ─────────────────────────────────────────────────────────────────────────

model Progress {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialSectionId String
  materialSection   MaterialSection @relation(fields: [materialSectionId], references: [id], onDelete: Cascade)
  status            ProgressStatus  @default(NOT_STARTED)
  progressPercent   Int             @default(0)
  lastAccessedAt    DateTime        @default(now())
  completedAt       DateTime?

  @@unique([userId, materialSectionId])
  @@map("progress")
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String
  iconUrl     String?
  earnedAt    DateTime @default(now())

  @@unique([userId, code])
  @@map("achievements")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

model Bookmark {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialSectionId String
  materialSection   MaterialSection @relation(fields: [materialSectionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([userId, materialSectionId])
  @@map("bookmarks")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Tutor chat history
// ─────────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Percakapan baru")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}
